    "check:coverage": "vite-node checks/coverage.ts",
    "check:roles": "vite-node checks/roles.ts",
    "check:all": "npm run check && npm run check:roles && npm run check:contrast && npm run check:icons && npm run check:joborders && npm run check:recruitment && npm run check:recruitment:screens && npm run check:coverage && npm run check:shape:contract && npm run check:payroll && npm run check:routes && npm run check:gate && npm run check:http && npm run check:intake && npm run check:people && npm run check:reachable",
    "check:http": "vite-node checks/http-services.ts",
    "check:shape": "vite-node checks/api-shape.ts",
