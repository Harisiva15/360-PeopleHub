# The API connects as app_rw, which cannot bypass row-level security.
DATABASE_URL=postgres://app_rw:CHANGE_ME@localhost:5432/peoplehub

# Migrations connect as the owning role instead. If these two are ever the
# same role, the policies stop meaning anything.
# DATABASE_URL=postgres://peoplehub_owner:CHANGE_ME@localhost:5432/peoplehub

# Pepper for session-token hashes. Rotating it invalidates every live session.
TOKEN_PEPPER=CHANGE_ME

# AES key for employee_identifier and bank account columns.
FIELD_ENCRYPTION_KEY=CHANGE_ME

PORT=8080
CORS_ORIGINS=https://harisiva15.github.io
