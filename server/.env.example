# Copy to server/.env and fill in. .env is gitignored — keep it that way.
#
# ---------------------------------------------------------------------------
# Supabase connection strings
#
# Supabase offers three, and they are not interchangeable. Find them under
# Project Settings -> Database -> Connection string.
#
#   Direct          db.<ref>.supabase.co:5432        IPv6 only on newer projects
#   Session pooler  aws-0-<region>.pooler.supabase.com:5432
#   Transaction     aws-0-<region>.pooler.supabase.com:6543
#
# Use 5432 (direct or session pooler) for MIGRATE_DATABASE_URL. The transaction
# pooler on 6543 multiplexes statements across connections, which breaks
# CREATE ROLE, advisory locks and anything that spans a session — migrations
# will fail in confusing ways.
#
# If your network has no IPv6, use the session pooler rather than direct.
# ---------------------------------------------------------------------------

# Migrations. Runs as the owning role (postgres on Supabase) because it creates
# policies the application role must not be able to drop.
MIGRATE_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# The API. Should NOT be the same role as above: app_rw is created NOBYPASSRLS
# so a bug cannot read across tenants. Until that role has a password, you can
# point this at the same string to get moving — but do not ship it that way.
DATABASE_URL=postgresql://app_rw:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Supabase project details, for verifying JWTs issued by Supabase Auth.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_JWT_SECRET=

PORT=8080
CORS_ORIGINS=https://harisiva15.github.io
