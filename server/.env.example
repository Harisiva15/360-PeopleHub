# Copy to server/.env and fill in the two lines at the top, then run:
#
#   npm run connect
#
# It discovers the project's region, verifies the credentials, and writes the
# four URLs below. That way the connection string — which contains the database
# password — never has to be copied through a chat window or a ticket.
SUPABASE_REF=
SUPABASE_DB_PASSWORD=

# The four lines below are written by `npm run connect`. Leave them empty.
MIGRATE_DATABASE_URL=
DATABASE_URL=

# Supabase project details. Tokens are ES256, verified against the published
# public keys — this server holds no signing secret at all, so a leak of
# everything it knows still does not let an attacker mint a token.
SUPABASE_URL=
SUPABASE_JWKS_URL=

# NEVER put SUPABASE_SECRET_KEY (sb_secret_...) here or anywhere this app
# reads. It is the service_role equivalent: it bypasses every row-level
# security policy in the schema. Nothing in this codebase wants it.

PORT=8080
CORS_ORIGINS=https://harisiva15.github.io
